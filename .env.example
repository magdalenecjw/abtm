# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real secrets.
# See docs/technical-specifications.md §30 (Configuration).

# Supabase Project Settings → Data API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Project Settings → API Keys → anon / public
# Safe to expose client-side — Row Level Security enforces access control.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Project Settings → API Keys → service_role
# SERVER-ONLY. Bypasses RLS entirely. Never prefix with NEXT_PUBLIC_,
# never import into client components, never log.
SUPABASE_SERVICE_ROLE_KEY=

# The shared passcode borrowers enter to submit a request (docs/workflows.md §3.2).
# Must not be exposed client-side (technical-specifications.md §22).
BORROW_PASSCODE=